/* =========================================================
   1. ГЛОБАЛЬНЫЕ СТИЛИ И ПОДСКАЗКИ
   ========================================================= */
QToolTip {
    background-color: #2b2b2b;
    color: #ffffff;
    border: 1px solid #555555;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 12px;
}

/* =========================================================
   2. ОСНОВНЫЕ КОНТЕЙНЕРЫ И САЙДБАРЫ
   ========================================================= */
/* Основной контент */
#mainContent {
    background-color: #1e1e1e;
}

/* Первый сайдбар (с иконками) */
#sidebar {
    background-color: #181818;
    border-right: 1px solid #333333; 
}

/* Кнопки первого сайдбара */
#sidebar QPushButton {
    border: none;
    background-color: transparent;
    border-radius: 8px;
}

#sidebar QPushButton:hover {
    background-color: #2d3748;
}

#sidebar QPushButton[active="true"] {
    background-color: #1a56db;
}

#sidebar QPushButton[active="true"]:hover {
    background-color: #1e3a8a;
}

/* Второй сайдбар (с контентом) */
#secondarySidebar {
    background-color: #181818;
    border: none; 
}

/* Линия-разделитель (ручка QSplitter) */
QSplitter::handle:horizontal {
    background-color: #333333;
}

QSplitter::handle:horizontal:hover {
    background-color: #555555; 
}

/* =========================================================
   3. TITLE BAR (ВЕРХНЯЯ ПАНЕЛЬ ОКНА)
   ========================================================= */
#customTitleBar QPushButton {
    border: none;
    background-color: transparent;
    padding: 0px;
    margin: 0px;
    border-radius: 0px;
    width: 46px;
    height: 32px;
}

#customTitleBar QPushButton:hover {
    background-color: #444444;
}

#customTitleBar #btnClose:hover {
    background-color: #e81123;
}

#customTitleBar #btnClose:pressed {
    background-color: #c50f1f;
}

/* Строка пути в TitleBar */
QLineEdit#pathEdit {
    background-color: #1e1e1e;
    color: #cccccc;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

QLineEdit#pathEdit:focus {
    border: 1px solid #007acc;
    background-color: #252526;
}

/* =========================================================
   4. EXPLORER (ДЕРЕВО ФАЙЛОВ)
   ========================================================= */
#explorerHeader {
    background-color: #181818;
    border-bottom: 1px solid #2b2b2b;
}

#explorerTitle {
    font-size: 11px;
    font-weight: bold;
    color: #bbbbbb;
    text-transform: uppercase;
    letter-spacing: 1px;
}

#fileExplorer {
    background-color: #181818;
}

QTreeView {
    background-color: #181818;
    color: #cccccc;
    border: none;
    outline: 0;
    show-decoration-selected: 0; /* Убирает лишние полоски выделения */
}

QTreeView::item {
    height: 24px;
    padding-left: 4px;
}

QTreeView::item:hover {
    background-color: #2a2d2e;
}

QTreeView::item:selected {
    background-color: #37373d;
    color: #ffffff;
}

QTreeView::branch {
    background: transparent;
}

/* =========================================================
   5. PDF VIEWER TOOLBAR (ПАНЕЛЬ ИНСТРУМЕНТОВ PDF)
   ========================================================= */
#pdfTopToolbar {
    background-color: #1e1e1e;
    border-bottom: 1px solid #333333;
}

#pdfTopToolbar QLabel {
    color: #cccccc;
    font-size: 12px;
}

/* Кнопки с иконками (стрелки, плюс, минус, рука, курсор) */
#pdfTopToolbar QPushButton {
    border: none;
    background-color: transparent;
    border-radius: 4px;
}

#pdfTopToolbar QPushButton:hover {
    background-color: #333333;
}

/* Состояние "нажато" для режимов (Рука, Курсор, Замок) */
#pdfTopToolbar QPushButton:checked {
    background-color: #37373d;
    color: #ffffff;
}

/* Спинбокс (номер страницы) */
#pdfTopToolbar QSpinBox {
    background-color: #2d2d2d;
    color: #cccccc;
    border: 1px solid transparent;
    border-radius: 4px;
}

#pdfTopToolbar QSpinBox:focus {
    border: 1px solid #007acc;
}

/* Комбобокс (зум) */
#pdfTopToolbar QComboBox {
    background-color: #2d2d2d;
    color: #cccccc;
    border: 1px solid transparent;
    border-radius: 4px;
    padding-left: 6px;
}

#pdfTopToolbar QComboBox:hover {
    background-color: #3c3c3c;
}

#pdfTopToolbar QComboBox::drop-down {
    border: none;
    width: 20px;
}

/* Выпадающий список зума */
#pdfTopToolbar QComboBox QAbstractItemView {
    background-color: #252526;
    color: #cccccc;
    selection-background-color: #04395e;
    border: 1px solid #333333;
}






/* --- Панель инструментов (Right Sidebar) --- */
#rightSidebar {
    background-color: #181818;
    border-left: 1px solid #333333;
}

/* --- Вкладки (Mode Tabs) --- */
#toolsTabBar {
    background-color: #181818;
    border-bottom: 1px solid #333333;
}

#toolsTabBar::tab {
    background-color: transparent;
    color: #888888;
    padding: 10px 20px;
    margin-right: 5px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: bold;
}

#toolsTabBar::tab:hover {
    color: #cccccc;
}

#toolsTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #007acc; /* Синяя полоска под активной вкладкой */
}
#rightSidebarTitle {
    font-size: 11px;
    font-weight: bold;
    color: #bbbbbb;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
}